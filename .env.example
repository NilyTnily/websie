# bunx randomstring length=32
AUTH_SECRET="..."

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS="you@example.com"

# Google OAuth ("Continue with Google") — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― UPLOADS ―――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="..."
UPLOADTHING_SECRET_KEY="sk_live_..."

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― EMAILS ――――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# https://resend.com/api-keys — free tier is enough for a small store.
# Sends from Resend's shared onboarding@resend.dev domain until you verify
# your own domain with them (RESEND_FROM_EMAIL below).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― INQUIRIES (WHATSAPP) ―――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# The WhatsApp number that receives "Send Inquiry" cart requests, in
# international format (digits only, no leading 0 or +). Every inquiry is
# always saved to the database and visible under /admin/inquiries even if
# this is left unset — this just also opens a pre-filled WhatsApp chat.
WHATSAPP_NUMBER="15551234567"

# WhatsApp Cloud API (inbound messages -> /admin/whatsapp inbox, tracking
# auto-matched to orders). Setup:
#   1. Create a Meta Business App with the WhatsApp product added; capture
#      WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN from the app dashboard.
#   2. App Settings -> Basic: copy WHATSAPP_APP_SECRET.
#   3. Register webhook URL https://<domain>/api/whatsapp/webhook under
#      WhatsApp -> Configuration, subscribed to the "messages" field.
#      WHATSAPP_VERIFY_TOKEN below must match what you enter there.
#   4. Local dev needs an HTTPS tunnel (ngrok/Cloudflare Tunnel) — Meta
#      cannot reach localhost directly.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# Outbound WhatsApp automation (order confirmations, status/shipping
# updates, staff new-order alerts). Requires the Cloud API credentials
# above PLUS approved message templates in Meta Business Manager -> WhatsApp
# Manager -> Message Templates (business-initiated messages cannot use
# free-form text). Template names below are optional overrides — if your
# approved template's name differs from the default, set it here.
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED="order_confirmed"
# WHATSAPP_TEMPLATE_ORDER_STATUS_UPDATE="order_status_update"
# WHATSAPP_TEMPLATE_ORDER_SHIPPED="order_shipped"
# WHATSAPP_TEMPLATE_ORDER_CANCELLED_REFUNDED="order_cancelled_refunded"
# WHATSAPP_TEMPLATE_STAFF_NEW_ORDER="staff_new_order"

# Comma-separated phone numbers (international format, digits only) that
# get a WhatsApp broadcast whenever a new order comes in. Same field is
# also editable from /admin/settings — that value wins over this one.
WHATSAPP_STAFF_NUMBERS=""

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
